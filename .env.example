# --- Aplicación ---
APP_ENV=local
APP_PORT=8080

# --- Base de datos ---
DB_HOST=db
DB_PORT=3306
DB_DATABASE=app
DB_USERNAME=app
DB_PASSWORD=cambia-esta-clave
DB_ROOT_PASSWORD=cambia-esta-clave-root

# --- Herramientas ---
ADMINER_PORT=8081

# --- Permisos de archivos (ejecuta `id -u` e `id -g` en Linux/WSL) ---
HOST_UID=1000
HOST_GID=1000

# --- Xdebug ---
XDEBUG_MODE=off
